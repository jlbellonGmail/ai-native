{
  "schemaVersion": "prompt-registry-storage.v1",
  "roadmapTask": "W4-T2",
  "storageRoot": "registries/prompts",
  "storageMode": "repository-filesystem",
  "description": "Repository-backed prompt registry storage contract for ENTERPRISE-10-10 W4-T2. This contract governs stored prompt file locations and integrity only; runtime databases and migrations are outside this task. W4-T3 compatibility policy is defined in config/prompt-registry/versioning.compatibility.json.",
  "layout": {
    "promptFamilyDirectory": "<prompt-family>",
    "storageSlotDirectory": "<storage-slot>",
    "promptFileName": "system-prompt.md",
    "pathTemplate": "registries/prompts/<prompt-family>/<storage-slot>/system-prompt.md",
    "storageSlotMeaning": "Filesystem coordinate for a major prompt version line. W4-T3 defines compatibility semantics."
  },
  "lifecycle": {
    "states": ["stored", "candidate", "active", "retired"],
    "initialState": "stored",
    "allowedTransitions": [
      { "from": "stored", "to": "candidate", "requires": "schema-valid-entry" },
      { "from": "candidate", "to": "active", "requires": "future-governance-approval" },
      { "from": "active", "to": "retired", "requires": "future-retirement-record" }
    ],
    "nonGoals": [
      "No runtime persistence is introduced.",
      "No database table, migration or service API is created.",
      "No W4-T4 ownership or approval workflow is closed.",
      "No W4-T5 evaluation linkage is closed by W4-T2."
    ]
  },
  "integrity": {
    "algorithm": "sha256",
    "requiredForEveryEntry": true
  },
  "entries": [
    {
      "id": "code-generator.system",
      "family": "code-generator",
      "storageSlot": "v1",
      "role": "system",
      "lifecycleState": "stored",
      "storagePath": "registries/prompts/code-generator/v1/system-prompt.md",
      "contentType": "text/markdown",
      "sha256": "2a5fb21671eb5c731a9dffc24d4a87e22b3154e1ef69e8b08e6861629554e1e5"
    },
    {
      "id": "code-generator.system",
      "family": "code-generator",
      "storageSlot": "v2",
      "role": "system",
      "lifecycleState": "stored",
