      "contentType": "text/markdown",
      "sha256": "51ac3a034496db9015661cd5e32fb82f8bd764068b24b85c1b63add3e6a3693f"
    },
    {
      "id": "code-generator.system",
      "family": "code-generator",
      "storageSlot": "v3",
      "role": "system",
      "lifecycleState": "stored",
      "storagePath": "registries/prompts/code-generator/v3/system-prompt.md",
      "contentType": "text/markdown",
      "sha256": "e72ec28199afe5f7f8fd2a52ff87922cb0b822fbbc05260b3fc76f31d46eee0e"
    }
  ],
  "governance": {
    "roadmapTask": "W4-T2",
    "closes": [
      "registry structure",
      "storage contract",
      "storage lifecycle"
    ],
    "doesNotClose": ["W4-T4", "W4-T5", "W4-T6"],
    "validation": "scripts/validate-prompt-registry-storage.mjs"
  }
}
