{
  "schemaVersion": "agent-registry-storage.v1",
  "roadmapTask": "W5-T2",
  "storageRoot": "registries/agents",
  "storageMode": "repository-filesystem",
  "description": "Repository-backed agent registry storage contract for ENTERPRISE-10-10 W5-T2. This contract governs stored agent file locations, lifecycle, retention and integrity only; runtime persistence, service APIs, capability catalog semantics, ownership approval chains and evaluation linkage are outside this task.",
  "layout": {
    "indexFile": "skills-index.md",
    "folderEntryTemplate": "registries/agents/<agent-family>/skill.md",
    "singleFileEntryTemplate": "registries/agents/<agent-family>.md",
    "pathStyle": "forward-slash-relative-paths"
  },
  "lifecycle": {
    "states": ["stored", "candidate", "active", "retired"],
    "initialState": "stored",
    "allowedTransitions": [
      { "from": "stored", "to": "candidate", "requires": "schema-valid-agent-entry" },
      { "from": "candidate", "to": "active", "requires": "future-governance-approval" },
      { "from": "active", "to": "retired", "requires": "future-retention-record" }
    ],
    "nonGoals": [
      "No runtime persistence is introduced.",
      "No database table, migration or service API is created.",
      "No W5-T3 capability catalog is closed.",
      "No W5-T4 ownership or approval workflow is closed.",
      "No W5-T5 evaluation linkage is closed."
    ]
  },
  "retention": {
    "policy": "git-retained-stable-paths",
    "minimumRetention": "retain-while-referenced-by-storage-contract",
    "pathChangeRule": "update-contract-and-checksum-before-dependent-use",
    "deletionRule": "future-retention-record-required"
  },
  "integrity": {
    "algorithm": "sha256",
    "requiredForEveryEntry": true
  },
  "entries": [
    {
      "id": "agent-skill-index",
      "family": "registry-index",
      "storageKind": "index",
      "lifecycleState": "stored",
