{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native.local/schemas/agent-registry-capability.v1.schema.json",
  "title": "Agent Registry Capability",
  "description": "Machine-readable contract for ENTERPRISE-10-10 W5-T3 Capabilities Catalog. This schema defines one governed capability record and its dependency model; it does not implement capabilities, activate agents, define ownership approval chains or bind evaluation runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "category",
    "sourceAgentEntries",
    "lifecycleState",
    "dependencyModel",
    "executionPolicy",
    "governance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "category": {
      "enum": [
        "discovery",
        "architecture",
        "interface-design",
        "experience-design",
        "quality-review",
        "documentation",
        "prompt-engineering",
        "knowledge-governance"
      ]
    },
    "sourceAgentEntries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "References W5-T2 storage entry ids only; no runtime agent is changed by W5-T3.",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "lifecycleState": {
      "enum": ["cataloged", "candidate", "retired"]
    },
    "dependencyModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "supports", "incompatibleWith"],
      "properties": {
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "supports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "incompatibleWith": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementationState", "runtimeActivation", "toolGrant"],
      "properties": {
        "implementationState": {
          "const": "not-implemented-by-W5-T3"
        },
        "runtimeActivation": {
          "const": "not-granted"
        },
        "toolGrant": {
          "const": "none"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roadmapTask", "changePolicy", "doesNotClose"],
      "properties": {
        "roadmapTask": {
          "const": "W5-T3"
        },
        "changePolicy": {
          "enum": ["catalog-review-required"]
        },
        "doesNotClose": {
          "type": "array",
          "items": {
            "enum": ["W5-T4", "W5-T5", "W5-T6"]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
