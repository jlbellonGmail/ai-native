  "benchmark_taxonomy": [
    {
      "id": "prompt_contract_benchmark",
      "definition": "Validates prompt-level behavior against governed prompt evaluation contracts."
    },
    {
      "id": "agent_contract_benchmark",
      "definition": "Validates agent-level behavior against governed agent evaluation contracts."
    },
    {
      "id": "task_completion_benchmark",
      "definition": "Defines task-completion expectations without executing the task in W3-T3."
    },
    {
      "id": "tool_use_benchmark",
      "definition": "Defines tool-use governance expectations, allowed tool boundaries, and abstention criteria."
    },
    {
      "id": "context_handling_benchmark",
      "definition": "Defines expectations for use of authorized context and handling of missing context."
    },
    {
      "id": "memory_handling_benchmark",
      "definition": "Defines expectations for memory availability, persistence, exclusion, and non-use."
    },
    {
      "id": "safety_policy_benchmark",
      "definition": "Defines safety, privacy, security, and policy adherence expectations."
    },
    {
      "id": "reproducibility_benchmark",
      "definition": "Defines conditions required for repeatable future benchmark execution."
    },
    {
      "id": "regression_benchmark",
      "definition": "Defines future comparison against prior approved behavior without executing regressions in W3-T3."
    },
    {
      "id": "robustness_benchmark",
      "definition": "Defines expected behavior under governed variation, ambiguity, incomplete input, and recoverable errors."
    }
