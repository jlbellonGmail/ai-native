{
  "$schema": "./schemas/agents.schema.json",
  "generatedNotice": "GENERATED by scripts/sync-agentic-adapters.ps1 from .agentic/. Do not edit manually.",
  "opencodeInstructions": [
    "AGENTS.md",
    ".claude/rules/*.md"
  ],
  "roles": {
    "analyst-agent": {
      "description": "Analiza un pedido de feature y produce una spec tecnica clara y accionable. Read-only. Se usa siempre en sesion nueva, como subagente.",
      "prompt": ".agentic/roles/analyst-agent.md",
      "claude": {
        "tools": [
          "Read",
          "Grep",
          "Glob"
        ],
        "model": "sonnet",
        "effort": "high"
      },
      "codex": {
        "model": "gpt-5.5",
        "model_reasoning_effort": "high"
      },
      "opencode": {
        "mode": "subagent",
        "model": "opencode-go/kimi-k2.7-code",
        "reasoningEffort": "high",
        "permission": {
          "edit": "deny",
          "bash": "deny",
          "webfetch": "deny"
        }
      }
    },
    "reviewer-agent": {
      "description": "Audita un spec.md producido por analyst-agent antes de que pase a implementacion. Read-only. Se usa siempre en sesion nueva, como subagente.",
      "prompt": ".agentic/roles/reviewer-agent.md",
      "claude": {
        "tools": [
          "Read",
          "Grep",
          "Glob"
        ],
        "model": "sonnet",
        "effort": "high"
      },
      "codex": {
        "model": "gpt-5.5",
        "model_reasoning_effort": "high"
      },
      "opencode": {
        "mode": "subagent",
        "model": "opencode-go/kimi-k2.7-code",
        "reasoningEffort": "high",
        "permission": {
          "edit": "deny",
          "bash": "deny",
          "webfetch": "deny"
        }
      }
    },
    "code-reviewer-agent": {
      "description": "Audita el diff final (codigo, tests, scripts, config, docs tecnicas) despues de que qa-agent aprueba. Read-only. Se usa siempre en sesion nueva, como subagente.",
      "prompt": ".agentic/roles/code-reviewer-agent.md",
      "claude": {
        "tools": [
          "Read",
          "Grep",
          "Glob"
        ],
        "model": "sonnet",
        "effort": "high"
      },
      "codex": {
        "model": "gpt-5.5",
        "model_reasoning_effort": "high"
      },
      "opencode": {
        "mode": "subagent",
        "model": "opencode-go/kimi-k2.7-code",
        "reasoningEffort": "high",
        "permission": {
          "edit": "deny",
          "bash": "deny",
          "webfetch": "deny"
        }
      }
    },
    "builder-agent": {
      "description": "Implementa la feature a partir de un spec.md aprobado. Write, corre siempre dentro de su propio git worktree, como subagente.",
      "prompt": ".agentic/roles/builder-agent.md",
      "claude": {
        "tools": [
          "Read",
          "Write",
          "Edit",
          "Bash",
          "Grep",
          "Glob"
        ],
        "model": "sonnet",
        "effort": "high"
      },
      "codex": {
        "model": "gpt-5.5",
        "model_reasoning_effort": "high"
      },
      "opencode": {
        "mode": "subagent",
        "model": "opencode-go/kimi-k2.7-code",
        "reasoningEffort": "high",
        "permission": {
          "edit": "allow",
          "bash": "allow"
        }
      }
    },
    "qa-agent": {
      "description": "Testea la implementacion del builder-agent contra el spec aprobado. Write (solo tests), mismo worktree, como subagente.",
      "prompt": ".agentic/roles/qa-agent.md",
      "claude": {
        "tools": [
          "Read",
          "Write",
          "Edit",
          "Bash",
          "Grep",
          "Glob"
        ],
        "model": "sonnet",
        "effort": "medium"
      },
      "codex": {
        "model": "gpt-5.5",
        "model_reasoning_effort": "medium"
      },
      "opencode": {
        "mode": "subagent",
        "model": "opencode-go/mimo-v2.5-pro",
        "reasoningEffort": "medium",
        "permission": {
          "edit": "allow",
          "bash": "allow"
        }
      }
    }
  }
}
