{
  "$schema": "./schemas/models.schema.json",
  "lastReviewed": "2026-09-13",
  "executionDeclaration": {"fileName": "run.yaml", "location": "runs/<NN>-<slug>/run.yaml", "scope": "Seleccion minima previa a spec.md: modelo, variante y fallback."},
  "validVariants": ["default", "none", "minimal", "low", "medium", "high", "xhigh", "max"],
  "fallbackAliases": {"go": "opencode-go", "zen": "opencode", "openrouter-free": "openrouter"},
  "providers": {
    "opencode-go": {"credentialEnv": ["AGENTIC_OPENCODE_GO_READY"], "credentialHelp": "Conectar OpenCode Go fuera del repo.", "models": ["gpt-5.6-luna", "kimi-k2.7-code", "mimo-v2.5-pro"]},
    "opencode": {"credentialEnv": ["AGENTIC_OPENCODE_ZEN_READY"], "credentialHelp": "Conectar OpenCode Zen fuera del repo.", "models": ["gpt-5.6-luna", "gpt-5.5", "gpt-5.3-codex", "gpt-5.1-codex", "kimi-k2.7-code", "mimo-v2.5-pro", "mimo-v2.5-free", "hy3-free"]},
    "openrouter": {"credentialEnv": ["OPENROUTER_API_KEY", "AGENTIC_OPENROUTER_READY"], "credentialHelp": "Configurar OpenRouter fuera del repo.", "requiresExplicitFallback": true, "models": ["qwen/qwen3-coder:free", "moonshotai/kimi-k2:free"]}
  },
  "roleAliases": {"analyst-agent": "planner", "builder-agent": "builder", "reviewer-agent": "reviewer", "qa-agent": "reviewer", "code-reviewer-agent": "reviewer"},
  "roles": {
    "planner": {"default": {"model": "opencode-go/kimi-k2.7-code", "variant": "high"}, "fallback": [{"label": "go", "model": "opencode-go/kimi-k2.7-code", "variant": "high"}, {"label": "zen", "model": "opencode/kimi-k2.7-code", "variant": "high"}, {"label": "openrouter-free", "model": "openrouter/qwen/qwen3-coder:free", "variant": "high"}]},
    "builder": {"default": {"model": "opencode-go/kimi-k2.7-code", "variant": "high"}, "fallback": [{"label": "go", "model": "opencode-go/kimi-k2.7-code", "variant": "high"}, {"label": "zen", "model": "opencode/kimi-k2.7-code", "variant": "high"}, {"label": "openrouter-free", "model": "openrouter/qwen/qwen3-coder:free", "variant": "high"}]},
    "reviewer": {"default": {"model": "opencode-go/kimi-k2.7-code", "variant": "high"}, "fallback": [{"label": "go", "model": "opencode-go/kimi-k2.7-code", "variant": "high"}, {"label": "zen", "model": "opencode/kimi-k2.7-code", "variant": "high"}, {"label": "openrouter-free", "model": "openrouter/qwen/qwen3-coder:free", "variant": "high"}]}
  }
}
