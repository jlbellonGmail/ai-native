{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native.local/contracts/acceptance-plan.schema.json",
  "title": "Acceptance plan",
  "description": "Per-feature acceptance plan (specs/<slug>/acceptance/plan.json, spec 002 RF-19..RF-22, RF-32, RF-33). Generated by the Builder as an ordinary reviewable artifact; untrusted until runtime/acceptance/plan.mjs validates it.",
  "type": "object",
  "required": [
    "schemaVersion",
    "slug",
    "criteria",
    "matrix",
    "datasets",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "matrix": {
      "type": "object"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "generator"
            ]
          },
          "path": {
            "type": "string"
          },
          "generator": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ac",
          "category",
          "runner",
          "sutPaths",
          "expected",
          "mandatory",
          "minTier",
          "why",
          "realSystemUse",
          "intentionalErrors",
          "limitations",
          "restore"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,100}$"
          },
          "ac": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]+$"
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "boundary",
              "integration",
              "contract",
              "persistence",
              "cross-cutting"
            ]
          },
          "dataset": {
            "type": "string"
          },
          "runner": {
            "type": "string"
          },
          "sutPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "string",
            "enum": [
              "pass",
              "reject"
            ]
          },
          "seededFailure": {
            "type": "object"
          },
          "mandatory": {
            "type": "boolean"
          },
          "minTier": {
            "type": "string",
            "enum": [
              "restricted",
              "node-permission",
              "container"
            ]
          },
          "why": {
            "type": "string"
          },
          "realSystemUse": {
            "type": "string"
          },
          "intentionalErrors": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          },
          "restore": {
            "type": "string"
          },
          "executionKind": {
            "type": "string",
            "enum": [
              "simulated",
              "real-integration"
            ]
          },
          "cross": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "manifest": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
